{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nullfx/distiller-recipes/blob/main/schema/report.schema.json",
  "title": "Distiller compatibility report",
  "description": "One player's result for one recipe on one Mac. Lives at reports/<game>/<recipe>/<report-id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "game", "recipe", "tier", "hardware", "date"],
  "properties": {
    "schema": { "const": 1 },
    "game": { "$ref": "#/$defs/slug" },
    "recipe": { "$ref": "#/$defs/slug" },
    "tier": { "enum": ["platinum", "gold", "silver", "bronze", "borked"] },
    "fps_avg": { "type": "number", "minimum": 0, "maximum": 1000 },
    "resolution": { "type": "string", "pattern": "^[0-9]{3,5}x[0-9]{3,5}$" },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chip", "chip_family", "chip_tier", "memory_gb", "macos", "rosetta"],
      "properties": {
        "chip": { "type": "string", "maxLength": 60 },
        "chip_family": { "type": "string", "pattern": "^(M[0-9]+|Intel|Unknown)$" },
        "chip_tier": { "enum": ["Base", "Pro", "Max", "Ultra"] },
        "gpu_cores": { "type": "integer", "minimum": 1, "maximum": 256 },
        "memory_gb": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "macos": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" },
        "rosetta": { "type": "boolean" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wine": { "type": "string", "maxLength": 80 },
        "graphics": { "type": "string", "maxLength": 80 }
      }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notes": { "type": "string", "maxLength": 2000 },
    "issue": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }
  }
}
